{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ATLAS Validation Run Record",
  "type": "object",
  "required": ["trial_id", "config_id", "selection_quality", "test_quality", "accelerator_hours", "peak_memory_gb", "tokens_per_second"],
  "properties": {
    "trial_id": {"type": "string"},
    "config_id": {"type": "string"},
    "selection_quality": {"type": "number", "minimum": 0, "maximum": 1, "description": "Validation-only score. Never use test metrics for selection."},
    "test_quality": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "accelerator_hours": {"type": "number", "exclusiveMinimum": 0, "description": "Training plus validation wall time multiplied by GPU count, in hours."},
    "peak_memory_gb": {"type": "number", "minimum": 0},
    "tokens_per_second": {"type": "number", "minimum": 0},
    "validation_loss": {"type": "number", "minimum": 0},
    "test_loss": {"type": ["number", "null"], "minimum": 0},
    "test_perplexity": {"type": ["number", "null"], "minimum": 1},
    "model_id": {"type": "string"},
    "model_revision": {"type": "string"},
    "dataset_id": {"type": "string"},
    "dataset_revision": {"type": "string"},
    "seed": {"type": "integer"},
    "gpu_name": {"type": "string"},
    "gpu_count": {"type": "integer", "minimum": 1},
    "code_git_commit": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
